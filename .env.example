# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB_NAME=preprint_data

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Timeout settings (seconds)
UPSTREAM_TIMEOUT=40
